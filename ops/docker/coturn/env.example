## Operator config (host-level) — coturn STUN/TURN
##
## STUN is on by default. TURN is a relay (it burns server bandwidth for the
## life of the connection — the cost this whole effort removes), so it stays OFF
## unless you deliberately enable it AND stand up a credential-issuing endpoint.

# --- STUN (always on) ------------------------------------------------------

# Public DNS name clients dial for STUN (e.g. stun.sereus.org). Published in the
# ICE manifest (see ops/docs/ice-servers.md). Also used as the coturn realm
# default. Informational here; clients reach the server via this name's A/AAAA.
STUN_PUBLIC_HOST=

# UDP+TCP port coturn listens on for STUN (container listens on 3478; this is the
# host port too). 3478 is the well-known STUN/TURN port.
LISTENING_PORT=3478

# Interface to bind. 0.0.0.0 = all interfaces (default). Use a specific IP to
# restrict. Applies both to the host port mapping and coturn's listening-ip.
HOST_BIND_IP=0.0.0.0

# Advanced: public IP to report in STUN/relay responses when the server sits
# behind 1:1 NAT (many cloud VMs). Leave empty if coturn already sees its public
# IP directly. If reflexive addresses come back as a private/NAT IP, set this.
EXTERNAL_IP=

# Host directory for state (rendered active config, TLS certs). Mounted at /data.
HOST_DATA_DIR=./data

# --- TURN (relay) — OFF by default -----------------------------------------
# Turning this on is a deliberate cost decision. Required reading before you do:
#   ops/docs/ice-servers.md  (STUN-first / TURN-off policy + the missing pieces)
# Enabling TURN ALSO requires:
#   - the credential issuer (../turn-credential-issuer/) deployed with the SAME
#     TURN_SECRET below, and clients pointed at its /ice-servers.json
#   - uncommenting the TURN relay port range in docker-compose.yml (or, better,
#     switching that file to host networking)
TURN_ENABLED=false

# Shared secret for ephemeral (time-limited HMAC-SHA1) credentials. coturn uses
# `use-auth-secret` + this value; the credential endpoint signs usernames with it.
# REQUIRED when TURN_ENABLED=true (the entrypoint refuses to start an open relay).
# Generate e.g.: openssl rand -hex 32
TURN_SECRET=

# TURN realm (e.g. turn.sereus.org). Defaults to STUN_PUBLIC_HOST if empty.
TURN_REALM=

# TURN relay port range coturn allocates for relayed media. Keep MIN/MAX in sync
# with the (commented) relay-range port mapping in docker-compose.yml.
MIN_RELAY_PORT=49160
MAX_RELAY_PORT=49200

# Abuse caps (apply to TURN). 0 = unlimited. total-quota: concurrent allocations
# server-wide; user-quota: per user; max-bps: per-session bandwidth cap.
TOTAL_QUOTA=0
USER_QUOTA=0
MAX_BPS=0

# --- TLS / DTLS (optional) -------------------------------------------------
# Provide both to offer stuns:/turns: on TLS_LISTENING_PORT. Paths are INSIDE the
# container — put certs under HOST_DATA_DIR and reference them as /data/<file>.
# Browsers accept plain stun: so TLS is NOT required for STUN.
TLS_CERT=
TLS_KEY=
TLS_LISTENING_PORT=5349
