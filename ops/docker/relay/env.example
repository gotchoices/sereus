## Operator config (host-level)

# Host port for raw TCP (container listens on 4001 internally)
HOST_PORT=4001

# Host port for WebSockets (container listens on 4002 internally). Clients with no
# raw TCP transport - React Native phones - can only reach this node here, so leave
# it published unless you have overridden LISTEN_ADDRS to drop the WebSocket listener.
HOST_WS_PORT=4011

# Host UDP port for STUN, which WebRTC peers use to find their public address before
# upgrading a relayed connection to a direct one. Apps derive stun:<relay host>:3478 from
# the relay address they are configured with, so keep this at 3478 unless your apps are
# configured with a different STUN URL.
HOST_STUN_PORT=3478

# Optional: bind to a specific host IP.
# Examples:
# - 0.0.0.0  (default, all interfaces)
# - 127.0.0.1 (localhost only)
HOST_BIND_IP=0.0.0.0

# Host directory where keys/state should live. This directory is mounted into the container at /data.
# Default is ./data (relative to your site instance directory).
HOST_DATA_DIR=./data

# Advanced: override the multiaddrs the container binds (comma-separated).
# Default is /ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws - raw TCP plus
# WebSockets. Changing the ports here means changing the mappings above too.
LISTEN_ADDRS=

# Public DNS name (or IP) this relay is reachable at, e.g. relay.sereus.org. RECOMMENDED.
# The relay advertises one address per listener on this host, using the public ports below,
# instead of its container-internal ones (127.0.0.1 and the docker bridge IP, which no client
# can dial and which poison the /p2p-circuit addresses NAT'd clients build). `./svc dns` also
# uses it as the default hostname. Leaving this and ANNOUNCE_ADDRS both empty logs a warning.
PUBLIC_HOST=

# Optional: the ports clients dial, when they differ from HOST_PORT / HOST_WS_PORT above —
# e.g. a home router forwarding external port 51234 to this host's HOST_WS_PORT. Leave empty
# to advertise the HOST ports.
PUBLIC_TCP_PORT=
PUBLIC_WS_PORT=

# Advanced: explicit advertised addresses (comma-separated multiaddrs). Overrides PUBLIC_HOST.
# Use it for what PUBLIC_HOST can't express: a wss address behind a TLS front, an IPv6-only
# name (/dns6), or a listener PUBLIC_HOST can't derive. A non-empty value REPLACES the entire advertised
# set, so include every transport clients need (tcp AND ws).
ANNOUNCE_ADDRS=

# Advanced: re-apply libp2p's default per-reservation cap (~128 KiB / 2 min) to
# every connection this relay carries. Leave empty (= off) for a party-operated
# relay: with the cap on, relayed cadre traffic is dropped by the receiving
# handler. Set to `true` only for a public-facing relay that wants the
# bandwidth brake back. See ../libp2p-infra/README.md.
RELAY_APPLY_DEFAULT_LIMIT=

# Set to `false` to turn off the STUN responder. Direct WebRTC upgrades then depend on
# some other STUN server; relayed connections are unaffected.
STUN_ENABLED=

# Advanced: maximum concurrent reservation slots handed out (default 500).
# One cadre member can hold several slots. Leave empty unless you are sizing a
# large deployment or deliberately constraining a small host.
RELAY_MAX_RESERVATIONS=


