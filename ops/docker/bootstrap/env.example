## Operator config (host-level)

# Host port for raw TCP (container listens on 4001 internally)
HOST_PORT=4002

# Host port for WebSockets (container listens on 4002 internally). Clients with no
# raw TCP transport - React Native phones - can only reach this node here, so leave
# it published unless you have overridden LISTEN_ADDRS to drop the WebSocket listener.
HOST_WS_PORT=4012

# Optional: bind to a specific host IP.
# Examples:
# - 0.0.0.0  (default, all interfaces)
# - 127.0.0.1 (localhost only)
HOST_BIND_IP=0.0.0.0

# Host directory where keys/state should live. This directory is mounted into the container at /data.
# Default is ./data (relative to your site instance directory).
HOST_DATA_DIR=./data

# Advanced: override the multiaddrs the container binds (comma-separated).
# Default is /ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws - raw TCP plus
# WebSockets. Changing the ports here means changing the mappings above too.
LISTEN_ADDRS=

# Advanced: force announced addresses (comma-separated multiaddrs).
# Most operators should leave this empty; prefer DNSADDR publishing instead.
ANNOUNCE_ADDRS=


