## Operator config (host-level) — turn-credential-issuer
##
## Serves the dynamic ICE-config manifest (/ice-servers.json) to WebRTC clients.
## When TURN is enabled, each fetch carries a freshly-minted, short-lived coturn
## credential. When TURN is off, the manifest is STUN-only.
##
## The service listens PLAIN HTTP — front it with your TLS reverse proxy
## (nginx/caddy). See README.md and ../../docs/ice-servers.md.

# --- HTTP listener ----------------------------------------------------------

# Port the service listens on (inside the container; also the host port mapped by
# docker-compose). Front this with a TLS reverse proxy.
ISSUER_PORT=8080

# Host interface to bind. Default 127.0.0.1 assumes the TLS proxy runs on the same
# host. Use 0.0.0.0 only if the proxy lives elsewhere (and a firewall fronts it).
HOST_BIND_IP=127.0.0.1

# --- STUN (always advertised) -----------------------------------------------

# Comma-separated STUN URLs to advertise. Match coturn's STUN_PUBLIC_HOST + port.
# e.g. stun:stun.sereus.org:3478
STUN_URLS=stun:stun.sereus.org:3478

# --- TURN (relay) — OFF by default ------------------------------------------
# A TURN entry is emitted ONLY when ALL of: TURN_ENABLED=true, TURN_SECRET set,
# TURN_URLS non-empty, AND TURN_POLICY is gated|on. Any of those false => the
# manifest is STUN-only. Required reading before enabling: ../../docs/ice-servers.md
TURN_ENABLED=false

# Operator intent, recorded in the manifest's `turnPolicy` field AND part of the
# gating decision:
#   off   - STUN-only (policy wins even if a secret is set)
#   gated - TURN exists, issued to all callers the issuer admits (rate-limited / token)
#   on    - TURN advertised broadly
# Set this to gated (or on) when you enable TURN, else it stays STUN-only.
TURN_POLICY=off

# Shared secret for ephemeral (HMAC-SHA1) credentials. MUST byte-for-byte match the
# coturn `TURN_SECRET` (static-auth-secret) of the co-located coturn service, or
# coturn will reject every minted credential. Generate e.g.: openssl rand -hex 32
TURN_SECRET=

# Comma-separated TURN URLs to advertise (match coturn's TURN host + transports).
# e.g. turn:turn.sereus.org:3478?transport=udp,turn:turn.sereus.org:3478?transport=tcp
TURN_URLS=

# Credential lifetime in seconds. Clamped to [60, 3600]. Default 300 (5 min). A
# leaked credential self-expires quickly; pick a margin over your max session-setup
# time. NOTE: coturn checks `expiry >= now` against ITS clock — the issuer and
# coturn MUST share time (run NTP on both).
CRED_TTL_SECONDS=300

# Opaque label baked into the credential username (`<expiry>:<id>`). Sanitized to
# [A-Za-z0-9._-]. Informational (e.g. for coturn logs); default "web".
CRED_ID=web

# --- Authorization & abuse limits -------------------------------------------

# Optional bearer token. When set, callers MUST supply it via
# `Authorization: Bearer <token>` OR `?token=<token>` (the query form lets you gate
# with zero client change by baking the token into the configured manifest URL).
# When empty, the endpoint is rate-limited-but-open (fine for a closed/trusted
# deployment). Recommended for production.
ISSUER_AUTH_TOKEN=

# Per-IP fixed-window rate limit (issuances per IP per minute). ALWAYS-ON bound on
# issuance. 0 disables it (discouraged). Note: fixed-window is approximate (a burst
# can straddle a window edge); coturn quotas are the hard backstop.
RATE_LIMIT_PER_MIN=30

# When true, read the client IP from the LAST (rightmost) hop of X-Forwarded-For —
# correct when exactly ONE trusted reverse proxy fronts the service. When false,
# XFF is ignored and the socket peer IP is used. Set this WRONG and you either
# collapse all clients into one bucket (false behind a proxy) or let clients spoof
# their IP to evade the limit (true with no trusted proxy). See README.
TRUST_PROXY=false

# CORS Access-Control-Allow-Origin for the manifest (cross-origin browsers fetch
# it). Default `*`. We send no cookies (header/query token only), so `*` is safe.
# Narrow to your app origin if you prefer.
CORS_ALLOW_ORIGIN=*

# --- Peer-bound issuance (per-node attribution) — OFF by default -------------
# The knobs above bind a credential to nobody: a shared token shipped in a browser
# bundle is effectively public, and per-IP limits are coarse (carrier NAT, proxies).
# With peer-bound issuance on, a Sereus node signs a short statement with its libp2p
# Ed25519 identity key; the issuer verifies it, derives the peer id, and uses that
# peer id as the credential's `<id>` label — so coturn logs attribute relayed bytes
# to a peer id, and you can allow/deny individual nodes. See README.md.

# off      - peer headers ignored entirely (today's behaviour)
# optional - a valid assertion earns a peer-labelled credential; a caller with NO
#            assertion still gets the existing token + rate-limited path
# required - a caller with no assertion gets a STUN-only manifest (never TURN).
#            Note it is a 200, not a 401: clients turn a non-OK response into an
#            EMPTY ice-server list, which would strip STUN too.
# Either non-off mode still returns 400/401 for a MALFORMED/INVALID assertion — a
# half-configured client must be loud, not silently downgraded.
PEER_AUTH_MODE=off

# The exact audience string the issuer requires. Clients sign the manifest URL they
# fetched with query + fragment stripped, e.g.
#   https://turn-issuer.example.org/ice-servers.json
# This binds an assertion to THIS issuer, so a signature harvested by another
# issuer cannot be replayed here. Leave empty to disable audience binding — the
# issuer warns loudly at boot, because that is the property you lose. Must not
# contain CR or LF (the service refuses to start if it does: no request header
# could ever match, so every assertion would be rejected for a non-obvious reason).
PEER_AUTH_AUDIENCE=

# Accept an assertion while |now - issuedAt| <= this, in seconds. Clamped to
# [5, 300]. This is the replay window: a captured assertion is refused after it,
# and within it the replay cache refuses a repeated (peerId, nonce). Bigger =
# friendlier to devices with drifting clocks, but a longer capture window. Issuer
# and client both need roughly correct time (NTP) — a badly skewed client is
# rejected and falls back to the unauthenticated path.
PEER_AUTH_SKEW_SECONDS=60

# Comma-separated base58btc peer ids (12D3KooW…) that MAY receive TURN. Empty means
# every verified peer may. A verified peer that is NOT on a non-empty list is not an
# error — it gets a normal 200 with a STUN-only manifest. This plus
# PEER_AUTH_MODE=required + TURN_POLICY=gated is the real "vetted clients only"
# configuration.
PEER_ALLOW_LIST=

# Comma-separated peer ids denied outright (403), checked before the allow list and
# before any per-peer limiter state is touched. This is how you cut off one
# misbehaving node without touching the rest.
PEER_DENY_LIST=

# Per-VERIFIED-PEER fixed-window issuance limit (per minute). Independent of
# RATE_LIMIT_PER_MIN, which still applies per IP first. 0 disables it (discouraged).
RATE_LIMIT_PER_PEER_PER_MIN=10

# Hard cap on live replay-cache entries (one per accepted assertion, retained for
# 2x PEER_AUTH_SKEW_SECONDS). At the cap the issuer returns 503 rather than accept
# an unrecorded nonce — it will NOT silently drop replay protection under load.
# Rough sizing: peak accepted assertions per 2x-skew window, with headroom.
REPLAY_CACHE_MAX=50000
