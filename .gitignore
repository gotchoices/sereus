node_modules/
dist/
tmp/
.yarnrc.yml
.DS_Store
.yarn
.pnp.*
*.tsbuildinfo
.in-progress

# Streamed build/lint/test output from ticket agents (`… | tee .tess-*.log`) — scratch, never source.
.tess-*.log

# Release-signing private keys — the cadre-host update secret is custodied
# offline and must NEVER be committed (see docs/cadre-host.md → Release signing).
*.key
cadre-host-release.key

# Expo prebuild artifacts (managed workflow — EAS generates these)
packages/reference-app-rn/android/
packages/reference-app-rn/ios/

# Playwright e2e artifacts for @serfab/reference-app-web
packages/reference-app-web/e2e/.fixture-state.json
packages/reference-app-web/test-results/
packages/reference-app-web/playwright-report/

# Standalone npm projects under ops/ (installed with `npm --prefix ops/<dir>`)
# follow the repo convention of not committing npm lockfiles — every install
# regenerates one, and it should not land in a commit.
# NOTE: no lockfile means their caret ranges resolve fresh on every install, so
# these diagnostic scripts can drift without anyone editing them; if one ever
# starts failing for no reason anybody changed, commit lockfiles for ops/ instead.
ops/**/package-lock.json
