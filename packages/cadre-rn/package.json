{
  "name": "@serfab/cadre-rn",
  "version": "1.12.0",
  "type": "module",
  "description": "React Native kit for Sereus apps - phone-node bring-up and lifecycle, secure key storage and node-local record slots, native crypto for libp2p-noise, the runtime polyfills a cadre node needs under Hermes, and the Metro configuration that bundles it",
  "files": [
    "src",
    "dist",
    "polyfills",
    "shims",
    "metro",
    "!dist/test",
    "!**/*.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    "./key-store": {
      "types": "./dist/key-store.d.ts",
      "import": "./dist/key-store.js"
    },
    "./node-local": {
      "types": "./dist/node-local.d.ts",
      "import": "./dist/node-local.js"
    },
    "./phone-node": {
      "types": "./dist/phone-node/index.d.ts",
      "import": "./dist/phone-node/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "import": "./dist/lifecycle/index.js"
    },
    "./noise-crypto": {
      "types": "./dist/noise-crypto.d.ts",
      "import": "./dist/noise-crypto.js"
    },
    "./native-digest": {
      "types": "./dist/native-digest.d.ts",
      "import": "./dist/native-digest.js"
    },
    "./polyfills": "./polyfills/index.js",
    "./polyfills/webrtc": "./polyfills/webrtc.js",
    "./boot-check": "./polyfills/boot-check.js",
    "./metro": "./metro/index.cjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/sereus.git",
    "directory": "packages/cadre-rn"
  },
  "author": "Got Choices Foundation",
  "license": "MIT",
  "keywords": [
    "sereus",
    "cadre",
    "react-native",
    "libp2p",
    "noise",
    "crypto",
    "polyfills",
    "hermes",
    "metro"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "dev:test": "vitest"
  },
  "dependencies": {
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/websockets": "^10.1.21",
    "@noble/hashes": "^2.0.0",
    "@optimystic/db-p2p": "^1.11.0",
    "@optimystic/db-p2p-storage-rn": "^1.11.0",
    "@ungap/structured-clone": "^1.3.0",
    "buffer": "^6.0.3",
    "event-target-polyfill": "^0.0.4",
    "readable-stream": "^4.7.0",
    "uint8arrays": "^6.1.1",
    "web-streams-polyfill": "^4.1.0"
  },
  "peerDependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@serfab/cadre-core": "workspace:^",
    "react-native": ">=0.79.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-nitro-modules": ">=0.31.2",
    "react-native-quick-base64": ">=3.0.0",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-webrtc": "^124.0.6"
  },
  "peerDependenciesMeta": {
    "@craftzdog/react-native-buffer": {
      "optional": true
    },
    "@serfab/cadre-core": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    },
    "react-native-quick-base64": {
      "optional": true
    },
    "react-native-quick-crypto": {
      "optional": true
    },
    "react-native-webrtc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@serfab/cadre-core": "workspace:^",
    "@types/node": "^25.0.10",
    "abort-controller": "3.0.0",
    "metro-resolver": "0.82.5",
    "react-native-quick-crypto": "^1.1.7",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "uint8arraylist": "^2.4.8",
    "vitest": "^4.0.17"
  }
}
