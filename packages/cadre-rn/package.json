{
  "name": "@serfab/cadre-rn",
  "version": "1.5.0",
  "type": "module",
  "description": "React Native kit for Sereus apps - native crypto for libp2p-noise and the runtime polyfills a cadre node needs under Hermes, with Metro configuration to follow",
  "files": [
    "src",
    "dist",
    "polyfills",
    "!dist/test",
    "!**/*.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    "./noise-crypto": {
      "types": "./dist/noise-crypto.d.ts",
      "import": "./dist/noise-crypto.js"
    },
    "./polyfills": "./polyfills/index.js",
    "./polyfills/webrtc": "./polyfills/webrtc.js",
    "./boot-check": "./polyfills/boot-check.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/sereus.git",
    "directory": "packages/cadre-rn"
  },
  "author": "Got Choices Foundation",
  "license": "MIT",
  "keywords": [
    "sereus",
    "cadre",
    "react-native",
    "libp2p",
    "noise",
    "crypto",
    "polyfills",
    "hermes"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "dev:test": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "@optimystic/db-p2p": "^1.6.0",
    "@ungap/structured-clone": "^1.3.0",
    "event-target-polyfill": "^0.0.4",
    "web-streams-polyfill": "^4.1.0"
  },
  "peerDependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "react-native": ">=0.79.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-webrtc": "^124.0.6"
  },
  "peerDependenciesMeta": {
    "@craftzdog/react-native-buffer": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    },
    "react-native-quick-crypto": {
      "optional": true
    },
    "react-native-webrtc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@libp2p/websockets": "^10.1.3",
    "@types/node": "^25.0.10",
    "abort-controller": "3.0.0",
    "react-native-quick-crypto": "^1.1.7",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "uint8arraylist": "^2.4.8",
    "vitest": "^4.0.17"
  }
}
