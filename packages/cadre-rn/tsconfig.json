{
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"module": "NodeNext",
		"target": "ES2020",
		// ES2022 so the type-checker knows `Error(message, { cause })`, used by the shared
		// test-harness/build-targets.ts this package's tests import.
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"moduleResolution": "NodeNext",
		"declaration": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true
	},
	"include": [
		"src"
	]
}
