{
  "name": "@serfab/cadre-host",
  "version": "0.9.0",
  "type": "module",
  "description": "Self-hosted cadre node manager for basement-PC deployments",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/bin/host.js",
  "files": [
    "src",
    "dist",
    "service",
    "!dist/test",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/sereus.git",
    "directory": "packages/cadre-host"
  },
  "keywords": [
    "sereus",
    "cadre",
    "host",
    "self-hosted",
    "p2p",
    "trust-circle"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.json --workspace ui",
    "test": "vitest run --passWithNoTests",
    "dev:test": "vitest",
    "start": "node dist/bin/host.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.0.10",
    "@types/pidusage": "^2.0.5",
    "@types/qrcode": "^1.5.5",
    "jsdom": "^25.0.1",
    "rimraf": "^6.1.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "^4.0.0",
    "@libp2p/crypto": "^5.1.13",
    "@libp2p/interface": "^3.1.0",
    "@libp2p/peer-id": "^6.0.4",
    "@serfab/cadre-cli": "workspace:^",
    "@serfab/cadre-core": "workspace:^",
    "@serfab/cadre-provider": "workspace:^",
    "commander": "^14.0.2",
    "debug": "^4.4.3",
    "fastify": "^5.7.1",
    "pidusage": "^4.0.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "MIT"
}
