<Page navigatingTo="onNavigatingTo" xmlns="http://schemas.nativescript.org/tns.xsd">
	<ActionBar title="Sereus NS — Solo Smoke" />

	<StackLayout padding="16">
		<Button
			text="Run solo smoke"
			tap="onRunSmoke"
			isEnabled="{{ !busy }}"
			automationText="run-solo-smoke" />
		<Label
			text="{{ status }}"
			textWrap="true"
			marginTop="16"
			automationText="solo-status" />
	</StackLayout>
</Page>
