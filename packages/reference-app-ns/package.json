{
  "name": "@serfab/reference-app-ns",
  "version": "0.8.0",
  "private": true,
  "main": "app/app.ts",
  "description": "NativeScript Core reference app — runtime validation of the cadre/db-p2p/Quereus/Optimystic stack on V8/JSC",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:bundle": "node scripts/bundle-check.js",
    "test:bundle:native": "ns prepare android",
    "test:e2e": "node scripts/run-e2e.mjs",
    "clean": "rimraf platforms hooks",
    "android": "ns run android",
    "ios": "ns run ios"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.4.9",
    "@formatjs/intl-getcanonicallocales": "^3.2.10",
    "@formatjs/intl-locale": "^5.3.9",
    "@formatjs/intl-numberformat": "^9.3.11",
    "@libp2p/circuit-relay-v2": "^4.1.3",
    "@libp2p/interface": "^3.1.0",
    "@libp2p/websockets": "^10.1.3",
    "@multiformats/multiaddr": "^12.5.1",
    "@nativescript-community/sqlite": "^3.5.0",
    "@nativescript/core": "~8.9.0",
    "@noble/hashes": "^2.0.0",
    "@optimystic/db-core": "^0.14.1",
    "@optimystic/db-p2p": "^0.14.1",
    "@optimystic/db-p2p-storage-ns": "^0.14.1",
    "@quereus/quereus": "^4.2.1",
    "@serfab/cadre-core": "workspace:^",
    "@ungap/structured-clone": "^1.3.0",
    "@valor/nativescript-websockets": "^2.0.3",
    "buffer": "^6.0.3",
    "event-target-polyfill": "^0.0.4",
    "readable-stream": "^4.7.0",
    "util": "^0.12.5",
    "web-streams-polyfill": "^4.1.0"
  },
  "devDependencies": {
    "@nativescript/android": "~8.9.0",
    "@nativescript/types": "~8.9.0",
    "@nativescript/webpack": "~5.0.35",
    "@types/readable-stream": "^4",
    "esbuild-loader": "^4.3.0",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
