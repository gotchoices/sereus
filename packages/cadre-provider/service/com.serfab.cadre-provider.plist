<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.serfab.cadre-provider</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/usr/local/lib/cadre-provider/dist/bin/provider.js</string>
    <string>start</string>
    <string>-c</string>
    <string>/usr/local/etc/cadre-provider/provider.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/cadre-provider/out.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/cadre-provider/err.log</string>
</dict>
</plist>
