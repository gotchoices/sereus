{
  "expo": {
    "name": "Sereus P2P Chat",
    "slug": "sereus-p2p-chat",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "sereus-chat",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "org.gotchoices.sereus.chat",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Sereus uses Face ID to unlock this device's secure identity key."
      }
    },
    "android": {
      "package": "org.gotchoices.sereus.chat",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "sereus-join"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "react-native-quick-crypto",
      [
        "expo-camera",
        {
          "cameraPermission": "Sereus uses the camera to scan the code a home machine shows when you add its node to your cadre.",
          "microphonePermission": "Unused: Sereus uses WebRTC data channels only and never requests microphone access.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Sereus uses the camera to scan the code a home machine shows when you add its node to your cadre.",
          "microphonePermission": "Unused: Sereus uses WebRTC data channels only and never requests microphone access."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38138c9f-4bdd-435e-b043-b48ad02c0e92"
      }
    }
  }
}
