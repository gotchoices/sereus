{
  "expo": {
    "name": "Sereus P2P Chat",
    "slug": "sereus-p2p-chat",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "sereus-chat",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "org.gotchoices.sereus.chat",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "org.gotchoices.sereus.chat",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38138c9f-4bdd-435e-b043-b48ad02c0e92"
      }
    }
  }
}
