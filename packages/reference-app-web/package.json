{
  "name": "@serfab/reference-app-web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && yarn typecheck:e2e && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:svelte": "svelte-check",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@libp2p/circuit-relay-v2": "^4.1.3",
    "@libp2p/crypto": "^5.1.13",
    "@libp2p/webrtc": "6.0.14",
    "@libp2p/websockets": "^10.1.3",
    "@multiformats/multiaddr": "^12.5.1",
    "@optimystic/db-core": "^0.17.0",
    "@optimystic/db-p2p": "^0.17.0",
    "@optimystic/db-p2p-storage-web": "^0.17.0",
    "@quereus/quereus": "^4.5.0",
    "@serfab/cadre-core": "*",
    "buffer": "^6.0.3",
    "idb": "^8.0.3",
    "readable-stream": "^4.7.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/readable-stream": "^4.0.18",
    "svelte-check": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
