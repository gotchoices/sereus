{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["svelte", "vite/client"]
  },
  // `test/` and `vitest.config.ts` are in here so a type error in the unit suite
  // (or a removed vitest option) fails `yarn typecheck` — vitest itself never
  // type-checks. The Playwright specs need `@playwright/test` types and stay in
  // `tsconfig.e2e.json`.
  "include": ["src/**/*.ts", "src/**/*.svelte", "test/**/*.ts", "vitest.config.ts"]
}
