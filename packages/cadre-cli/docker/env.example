# Sereus Cadre Node Environment Configuration
# Copy this file to .env and customize for your deployment
#
# The node refuses to start on a CADRE_* variable it does not recognise, so a
# misspelled name fails loudly instead of being ignored. See the package
# README's "Environment variables" section for the full list.

# ============================================================================
# REQUIRED: Control Network Identity
# ============================================================================

# Your party UUID (identifies your control network)
CADRE_PARTY_ID=

# Bootstrap nodes to connect to (comma-separated multiaddrs). Leave empty for a
# node with no one to dial, which waits to be dialed (a cadre's founding node).
# Example: /dns4/bootstrap.example.com/tcp/4001/p2p/12D3KooW...,/ip4/1.2.3.4/tcp/4001/p2p/12D3KooW...
CADRE_BOOTSTRAP_NODES=

# ============================================================================
# Node Class
# ============================================================================

# Node class: 'server' (always-on machine) or 'device' (edge/mobile)
# Default: server
CADRE_NODE_CLASS=server

# Storage quota in bytes (optional, only for a server node)
# Example: 10737418240 (10 GB)
CADRE_STORAGE_QUOTA=

# ============================================================================
# Network Configuration
# ============================================================================

# Addresses to listen on (comma-separated). Phones dial only the WebSocket one.
# Default: /ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws
CADRE_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws

# Addresses to announce INSTEAD OF the listen addresses (comma-separated). A
# non-empty value replaces everything the node advertises, relay address included.
# Prefer CADRE_APPEND_ANNOUNCE_ADDRS unless you mean that.
# Example: /dns4/mynode.example.com/tcp/4001
CADRE_ANNOUNCE_ADDRS=

# Addresses to announce IN ADDITION TO the listen addresses (comma-separated):
# the usual way to publish a forwarded public address. Phones need a /ws one.
# Example: /dns4/mynode.example.com/tcp/4001,/dns4/mynode.example.com/tcp/4002/ws
CADRE_APPEND_ANNOUNCE_ADDRS=

# Relay servers for NAT traversal (comma-separated)
# Example: /dns4/relay.example.com/tcp/4001/p2p/12D3KooW...
CADRE_RELAY_ADDRS=

# Offer a WebRTC address as well, so a peer that reached this node through a relay
# can move the connection onto a direct path. Needs CADRE_RELAY_ADDRS (WebRTC's
# connection setup is signalled over the relayed connection); with no relay the node
# logs one line and runs unchanged. Pointless on a node with a forwarded public port,
# which peers already dial directly. Empty = off.
CADRE_WEBRTC=

# STUN servers for CADRE_WEBRTC (comma-separated stun: URLs), replacing the ones
# derived from CADRE_RELAY_ADDRS. Each Sereus relay answers STUN on port 3478, so set
# this only for a relay that answers elsewhere, or a STUN server that is not a relay.
# Example: stun:stun.example.com:3478
CADRE_STUN_URLS=

# Run a circuit-relay server on this node (relay connections for other peers).
# Empty = node-class default: true for 'server', false for 'device'.
# Set 'true' or 'false' to override.
CADRE_ENABLE_RELAY=

# ============================================================================
# Host Port Bindings
# ============================================================================

# Host port for libp2p TCP (maps to container port 4001)
HOST_P2P_PORT=4001

# Host port for libp2p WebSocket (maps to container port 4002)
HOST_WS_PORT=4002

# Host port for health check endpoint
HOST_HEALTH_PORT=8080

# Host port for Prometheus metrics
HOST_METRICS_PORT=9090

# Host interface the health (8080) and metrics (9090) ports bind to.
# Default 127.0.0.1 (loopback only) — these surfaces should NOT be reachable
# from the public internet. Set to 0.0.0.0 ONLY behind a firewall / on a trusted
# management network if you need remote health probes or metrics scraping.
HOST_HEALTH_BIND=127.0.0.1
HOST_METRICS_BIND=127.0.0.1

# ============================================================================
# Seed Delivery (Optional)
# ============================================================================

# Bearer token gating the HTTP seed endpoint. When UNSET (the default), POST /seed
# is not registered and the health port serves only read-only probes. When set,
# the node registers an authenticated POST /seed that requires
# `Authorization: Bearer <this token>`. Use a long random value (e.g. `openssl rand -hex 32`).
# CADRE_SEED_TOKEN=

# Comma-separated base64url owner keys pinned as cold-start seed-trust anchors
# (unions with the repeatable `--pin-owner-key` flag). This is the *trust* anchor,
# independent of CADRE_SEED_TOKEN (the *delivery* gate). A cold node with an empty
# OwnerKey table REJECTS every seed (`--seed` and POST /seed) unless the seed's
# signer is pinned here or already DB-known — even with a valid bearer token. Leave
# unset on an already-enrolled node (DB-anchored trust applies).
# CADRE_OWNER_KEYS=

# ============================================================================
# Strand Filtering (Optional)
# ============================================================================

# Filter which strands this node participates in
# Options: all, none, or JSON object like {"sAppId":"..."} or {"strandId":"..."}
# A malformed/unrecognized value makes the node refuse to start (it will not
# silently fall back to "all").
# Default: all (participate in all strands)
CADRE_STRAND_FILTER=

# ============================================================================
# Hibernation Settings
# ============================================================================

# Enable strand hibernation for idle strands
CADRE_HIBERNATION_ENABLED=true

# Default latency hint: realtime, interactive, background, archive
CADRE_LATENCY_HINT=interactive

# Strand watcher backstop in milliseconds: the watcher re-reads on every change to
# its tables, and at least this often when no change is heard
CADRE_STRAND_WATCH_INTERVAL=300000

# ============================================================================
# Resource Limits
# ============================================================================

# Maximum memory for container (Docker memory limit)
CONTAINER_MEMORY_LIMIT=4G

# ============================================================================
# Debug & Development
# ============================================================================

# Enable debug logging (set to any non-empty value to enable)
# CADRE_DEBUG=1

