# Sereus Cadre Node Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================================================
# REQUIRED: Control Network Identity
# ============================================================================

# Your party UUID (identifies your control network)
CADRE_PARTY_ID=

# Bootstrap nodes to connect to (comma-separated multiaddrs)
# Example: /dns4/bootstrap.example.com/tcp/4001/p2p/12D3KooW...,/ip4/1.2.3.4/tcp/4001/p2p/12D3KooW...
CADRE_BOOTSTRAP_NODES=

# ============================================================================
# Node Profile
# ============================================================================

# Node profile: 'storage' (server) or 'transaction' (edge/mobile)
# Default: storage
CADRE_PROFILE=storage

# Storage quota in bytes (optional, only for storage profile)
# Example: 10737418240 (10 GB)
CADRE_STORAGE_QUOTA=

# ============================================================================
# Network Configuration
# ============================================================================

# Addresses to listen on (comma-separated)
# Default: /ip4/0.0.0.0/tcp/4001
CADRE_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001

# Addresses to announce externally (comma-separated)
# ACCEPTED BUT NOT YET APPLIED: no upstream db-p2p option carries this to libp2p
# yet, so the node warns at start and keeps advertising its listen/relay
# addresses. Use CADRE_RELAY_ADDRS below for reachability behind NAT today.
# Example: /dns4/mynode.example.com/tcp/4001
CADRE_ANNOUNCE_ADDRS=

# Relay servers for NAT traversal (comma-separated)
# Example: /dns4/relay.example.com/tcp/4001/p2p/12D3KooW...
CADRE_RELAY_ADDRS=

# Run a circuit-relay server on this node (relay connections for other peers).
# Empty = profile default: true for 'storage', false for 'transaction'.
# Set 'true' or 'false' to override.
CADRE_ENABLE_RELAY=

# ============================================================================
# Host Port Bindings
# ============================================================================

# Host port for libp2p (maps to container port 4001)
HOST_P2P_PORT=4001

# Host port for health check endpoint
HOST_HEALTH_PORT=8080

# Host port for Prometheus metrics
HOST_METRICS_PORT=9090

# Host interface the health (8080) and metrics (9090) ports bind to.
# Default 127.0.0.1 (loopback only) — these surfaces should NOT be reachable
# from the public internet. Set to 0.0.0.0 ONLY behind a firewall / on a trusted
# management network if you need remote health probes or metrics scraping.
HOST_HEALTH_BIND=127.0.0.1
HOST_METRICS_BIND=127.0.0.1

# ============================================================================
# Seed Delivery (Optional)
# ============================================================================

# Bearer token gating the HTTP seed endpoint. When UNSET (the default), POST /seed
# is not registered and the health port serves only read-only probes. When set,
# the node registers an authenticated POST /seed that requires
# `Authorization: Bearer <this token>`. Use a long random value (e.g. `openssl rand -hex 32`).
# CADRE_SEED_TOKEN=

# Comma-separated base64url owner keys pinned as cold-start seed-trust anchors
# (unions with the repeatable `--pin-owner-key` flag). This is the *trust* anchor,
# independent of CADRE_SEED_TOKEN (the *delivery* gate). A cold node with an empty
# OwnerKey table REJECTS every seed (`--seed` and POST /seed) unless the seed's
# signer is pinned here or already DB-known — even with a valid bearer token. Leave
# unset on an already-enrolled node (DB-anchored trust applies).
# CADRE_OWNER_KEYS=

# ============================================================================
# Strand Filtering (Optional)
# ============================================================================

# Filter which strands this node participates in
# Options: all, none, or JSON object like {"sAppId":"..."} or {"strandId":"..."}
# A malformed/unrecognized value makes the node refuse to start (it will not
# silently fall back to "all").
# Default: all (participate in all strands)
CADRE_STRAND_FILTER=

# ============================================================================
# Hibernation Settings
# ============================================================================

# Enable strand hibernation for idle strands
CADRE_HIBERNATION_ENABLED=true

# Default latency hint: realtime, interactive, background, archive
CADRE_LATENCY_HINT=interactive

# Strand watcher polling interval in milliseconds
CADRE_STRAND_WATCH_INTERVAL=5000

# ============================================================================
# Resource Limits
# ============================================================================

# Maximum memory for container (Docker memory limit)
CONTAINER_MEMORY_LIMIT=4G

# ============================================================================
# Debug & Development
# ============================================================================

# Enable debug logging (set to any non-empty value to enable)
# CADRE_DEBUG=1

# ============================================================================
# Provider Integration (Optional)
# ============================================================================

# Enrollment token from provider (for automated enrollment)
# CADRE_ENROLLMENT_TOKEN=

# Provider API endpoint for status reporting
# CADRE_PROVIDER_API=

# Provider API key
# CADRE_PROVIDER_API_KEY=

