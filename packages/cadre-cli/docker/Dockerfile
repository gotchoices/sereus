# Sereus Cadre Node Docker Image
# Multi-stage build for a minimal production image, built with the Yarn 4
# workspace toolchain (the repo is a Yarn 4.12.0 / node-modules workspace).
#
# Build closure for @serfab/cadre-cli is two workspaces: cadre-core -> cadre-cli.
# (strand-proto is deprecated and no longer a dependency of either package.)
#
# IMPORTANT — intentional deviations from the repo install:
#   * This image uses a Docker-specific workspace root
#     (docker/workspace-root.package.json) that narrows `workspaces` to the two
#     needed packages and OMITS the repo's `resolutions` block. That block links
#     @optimystic/* and @quereus/* to sibling checkouts (../optimystic, ../quereus)
#     that live OUTSIDE this build context, so it cannot be honored in-image. The
#     pinned versions are published to the registry, so dropping the resolutions
#     resolves them from npm — which is also the correct semantics for a
#     deployable image (it ships published versions, not a dev's local checkout).
#   * We DO copy the repo yarn.lock in to seed transitive version pinning: a
#     lockfile-free install drifts to newer @libp2p/* / multiaddr versions whose
#     TS types are incompatible across the tree and break `tsc`. Seeding with the
#     repo lock keeps the known-good transitive set; the dropped `resolutions`
#     still force @optimystic/* / @quereus/* to re-resolve from the registry.
#   * Because that seeded lock is pinned to the link: targets for the dropped
#     packages, the install is intentionally NOT --immutable: it regenerates a
#     lockfile scoped to this image (registry entries for optimystic/quereus). The
#     Docker-specific .yarnrc.yml carries only `nodeLinker: node-modules` (no
#     leaked npmAuthToken, no RN packageExtensions).

# ============================================================================
# Stage 1: install workspace dependencies (manifests only, for layer caching)
# ============================================================================
FROM node:22-alpine AS deps
WORKDIR /app
RUN apk add --no-cache python3 make g++
RUN corepack enable

COPY packages/cadre-cli/docker/workspace-root.package.json ./package.json
COPY packages/cadre-cli/docker/workspace.yarnrc.yml ./.yarnrc.yml
COPY packages/cadre-core/package.json packages/cadre-core/
COPY packages/cadre-cli/package.json  packages/cadre-cli/
# Seed transitive version pinning (see header note); regenerated by install.
COPY yarn.lock ./yarn.lock

RUN yarn install

# ============================================================================
# Stage 2: compile the workspaces in topological order (deps build first)
# ============================================================================
FROM deps AS build
WORKDIR /app

COPY packages/cadre-core/src packages/cadre-core/src
COPY packages/cadre-core/tsconfig.json packages/cadre-core/tsconfig.build.json packages/cadre-core/
COPY packages/cadre-cli/src packages/cadre-cli/src
COPY packages/cadre-cli/tsconfig.json packages/cadre-cli/tsconfig.build.json packages/cadre-cli/

RUN yarn workspaces foreach -At run build

# ============================================================================
# Stage 3: production-only dependency tree (registry deps + workspace symlinks)
# ============================================================================
FROM node:22-alpine AS prod-deps
WORKDIR /app
# Same toolchain as `deps`: a production dep with no musl prebuild compiles from
# source here, so node-gyp's python3/make/g++ must be present (this stage is
# discarded — only its node_modules is copied — so it adds no final-image bulk).
RUN apk add --no-cache python3 make g++
RUN corepack enable
COPY packages/cadre-cli/docker/workspace-root.package.json ./package.json
COPY packages/cadre-cli/docker/workspace.yarnrc.yml ./.yarnrc.yml
COPY packages/cadre-core/package.json packages/cadre-core/
COPY packages/cadre-cli/package.json  packages/cadre-cli/
COPY --from=deps /app/yarn.lock ./yarn.lock
RUN yarn workspaces focus @serfab/cadre-cli --production

# ============================================================================
# Stage 4: minimal runtime image
# ============================================================================
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup -S cadre && adduser -S cadre -G cadre

# Production node_modules (registry deps + symlinked workspace packages)
COPY --from=prod-deps /app/node_modules ./node_modules
# Built workspace outputs (dist) + their manifests — the symlinks in
# node_modules (cadre-core) resolve to these /app/packages/<pkg> paths.
COPY --from=build /app/packages/cadre-core/dist ./packages/cadre-core/dist
COPY --from=build /app/packages/cadre-core/package.json ./packages/cadre-core/
COPY --from=build /app/packages/cadre-cli/dist ./packages/cadre-cli/dist
COPY --from=build /app/packages/cadre-cli/package.json ./packages/cadre-cli/

# Copy entrypoint script
COPY packages/cadre-cli/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create data directory
RUN mkdir -p /data && chown -R cadre:cadre /data

# Volumes for persistent data
VOLUME ["/data"]

# Default ports: libp2p (4001), health check (8080), metrics (9090)
EXPOSE 4001/tcp 8080/tcp 9090/tcp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost:8080/health || exit 1

# Switch to non-root user
USER cadre

# Set default environment variables
ENV DATA_DIR=/data \
    CADRE_PROFILE=storage \
    CADRE_STORAGE_TYPE=file \
    CADRE_STORAGE_PATH=/data/storage \
    CADRE_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001 \
    CADRE_HEALTH_PORT=8080 \
    CADRE_METRICS_PORT=9090 \
    CADRE_HIBERNATION_ENABLED=true

ENTRYPOINT ["/entrypoint.sh"]
CMD ["start"]
