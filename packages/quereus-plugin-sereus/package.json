{
	"name": "@serfab/quereus-plugin-sereus",
	"version": "1.11.0",
	"type": "module",
	"description": "Quereus plugin that connects to a Sereus strand for SQL access",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"src",
		"dist",
		"!dist/test",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./plugin": {
			"types": "./dist/plugin.d.ts",
			"browser": "./dist/plugin-browser.js",
			"import": "./dist/plugin.js"
		},
		"./plugin-browser": {
			"types": "./dist/plugin-browser.d.ts",
			"import": "./dist/plugin-browser.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gotchoices/sereus.git",
		"directory": "packages/quereus-plugin-sereus"
	},
	"author": "Got Choices Foundation",
	"license": "MIT",
	"keywords": [
		"quereus-plugin",
		"quereus",
		"sereus",
		"strand",
		"distributed",
		"database",
		"sql",
		"p2p"
	],
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsc -p tsconfig.build.json && node scripts/build-browser.mjs",
		"typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
		"test": "vitest run",
		"test:e2e": "vitest run --project e2e",
		"dev:test": "vitest"
	},
	"devDependencies": {
		"@types/debug": "^4.1.12",
		"@types/node": "^25.0.10",
		"@vitest/coverage-v8": "^4.0.17",
		"acorn": "^8.12.0",
		"esbuild": "^0.27.2",
		"fake-indexeddb": "^6.2.4",
		"jsdom": "^25.0.1",
		"marked": "^18.0.14",
		"rimraf": "^6.1.2",
		"typescript": "^5.9.3",
		"vitest": "^4.0.17"
	},
	"dependencies": {
		"@libp2p/circuit-relay-v2": "^4.2.13",
		"@libp2p/interface": "^3.3.0",
		"@libp2p/websockets": "^10.1.21",
		"@optimystic/db-core": "^1.9.0",
		"@optimystic/db-p2p": "^1.9.0",
		"@optimystic/db-p2p-storage-fs": "^1.9.0",
		"@optimystic/db-p2p-storage-web": "^1.9.0",
		"@optimystic/quereus-plugin-crypto": "^1.9.0",
		"@optimystic/quereus-plugin-optimystic": "^1.9.0",
		"@quereus/quereus": "^4.20.0",
		"debug": "^4.4.3"
	},
	"quereus": {
		"provides": {
			"vtables": [
				"optimystic"
			],
			"functions": [
				"StampId",
				"digest",
				"sign",
				"verify",
				"randomBytes"
			]
		},
		"settings": [
			{
				"key": "strand_id",
				"label": "Strand ID",
				"type": "string"
			},
			{
				"key": "bootstrap_nodes",
				"label": "Bootstrap nodes",
				"type": "string",
				"default": "",
				"help": "comma-separated multiaddrs"
			},
			{
				"key": "schema",
				"label": "sApp schema",
				"type": "string"
			},
			{
				"key": "sapp_id",
				"label": "sApp ID",
				"type": "string",
				"default": "unknown"
			},
			{
				"key": "sapp_version",
				"label": "sApp version",
				"type": "string",
				"default": "1.0.0"
			},
			{
				"key": "port",
				"label": "Port",
				"type": "number",
				"default": 0,
				"help": "0 = random"
			},
			{
				"key": "enable_cache",
				"label": "Enable cache",
				"type": "boolean",
				"default": true
			},
			{
				"key": "fret_profile",
				"label": "FRET profile",
				"type": "select",
				"options": [
					"edge",
					"core"
				],
				"default": "edge"
			},
			{
				"key": "transactor",
				"label": "Transactor",
				"type": "select",
				"options": [
					"network",
					"local",
					"test"
				],
				"help": "storage engine"
			},
			{
				"key": "storage_path",
				"label": "Storage path",
				"type": "string",
				"help": "Node only"
			}
		]
	}
}
