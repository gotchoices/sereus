{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Has to reach the repo root: test/global-setup.ts imports
		// test-harness/build-freshness.ts by relative path, and TypeScript reports
		// TS6059 for any program file above rootDir even under noEmit.
		"rootDir": "../..",
		"noEmit": true
	},
	"include": ["src", "test", "vitest.config.ts"]
}
