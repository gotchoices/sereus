{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// rootDir reaches the repo root because test/global-setup.ts imports test-harness by
		// relative path. Nothing is emitted from this config; tsconfig.build.json does that.
		"rootDir": "../..",
		"noEmit": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node"]
	},
	"include": [
		"src",
		"test",
		"vitest.config.ts"
	]
}
