{
  "name": "sereus-workspace",
  "version": "0.9.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "description": "Sereus monorepo",
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "@optimystic/quereus-plugin-crypto": "link:../optimystic/packages/quereus-plugin-crypto",
    "@optimystic/quereus-plugin-optimystic": "link:../optimystic/packages/quereus-plugin-optimystic",
    "@optimystic/db-core": "link:../optimystic/packages/db-core",
    "@optimystic/demo": "link:../optimystic/packages/demo",
    "@optimystic/db-p2p": "link:../optimystic/packages/db-p2p",
    "@optimystic/db-p2p-storage-ns": "link:../optimystic/packages/db-p2p-storage-ns",
    "@optimystic/db-p2p-storage-rn": "link:../optimystic/packages/db-p2p-storage-rn",
    "@optimystic/db-p2p-storage-web": "link:../optimystic/packages/db-p2p-storage-web",
    "@quereus/quereus": "link:../quereus/packages/quereus"
  },
  "scripts": {
    "clean": "yarn workspaces foreach -A run clean",
    "build": "yarn workspaces foreach -At run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "yarn workspaces foreach -A run test && yarn test:dep-ranges && yarn test:vitest-typecheck-coverage && yarn test:test-file-typecheck-coverage",
    "test:dep-ranges": "node --test scripts/check-dep-ranges.test.mjs",
    "test:vitest-typecheck-coverage": "node --test scripts/check-vitest-typecheck-coverage.test.mjs",
    "test:test-file-typecheck-coverage": "node --test scripts/check-test-file-typecheck-coverage.test.mjs",
    "test:all": "yarn workspaces foreach -A run test:all",
    "dep-check": "knip && yarn check:dep-ranges",
    "check:dep-ranges": "node scripts/check-dep-ranges.mjs",
    "check:vitest-typecheck-coverage": "node scripts/check-vitest-typecheck-coverage.mjs",
    "check:test-file-typecheck-coverage": "node scripts/check-test-file-typecheck-coverage.mjs",
    "doc": "yarn workspaces foreach -A run doc",
    "typecheck": "yarn workspaces foreach -A run typecheck && yarn check:vitest-typecheck-coverage && yarn check:test-file-typecheck-coverage",
    "check:svelte": "yarn workspaces foreach -A run check:svelte",
    "bump": "bumpp --recursive",
    "release": "yarn bump && yarn pub",
    "pub": "yarn pub:strand-proto && yarn pub:quereus-plugin-sereus && yarn pub:cadre-core && yarn pub:cadre-cli && yarn pub:cadre-provider && yarn pub:cadre-host",
    "pub:strand-proto": "node scripts/publish-package.js strand-proto",
    "pub:quereus-plugin-sereus": "node scripts/publish-package.js quereus-plugin-sereus",
    "pub:cadre-core": "node scripts/publish-package.js cadre-core",
    "pub:cadre-cli": "node scripts/publish-package.js cadre-cli",
    "pub:cadre-provider": "node scripts/publish-package.js cadre-provider",
    "pub:cadre-host": "node scripts/publish-package.js cadre-host",
    "upgrade:optimystic": "ncu -u --workspaces --filter '/@optimystic/.*/'",
    "upgrade:quereus": "ncu -u --workspaces --filter '/@quereus/.*/'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bumpp": "^10.4.0",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "knip": "^6.15.0",
    "semver": "^7.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.0.17"
  }
}
