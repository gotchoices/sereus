-- The chat schema the reference app actually runs. Deliberately omits application-level
-- crypto: no signature verification, no invite flow, no authorization constraints.

-- Not `Member`: that name belongs to the strand's own membership table, and an app table
-- may not reuse a strand table name (docs/strands.md "Reserved Table Names").
table Participant (
    Id text primary key,
    Name text not null check (length(Name) between 1 and 100),
    -- App-level role (owner | member). Not a cadre-core RBAC primitive: strand
    -- membership is MemberPrivateKey-granular at the control-network layer; this
    -- role lives in the chat app and is assigned on closed-strand create/join.
    Role text not null default 'member' check (Role in ('owner', 'member'))
);

table Message (
    -- Text UUID primary key: generated locally by each peer so concurrent posts
    -- into a shared strand never collide. A max(Id)+1 integer key is NOT a safe
    -- alternative: a concurrent duplicate-key insert is silently last-writer-wins
    -- here, not refused, so the losing row is lost with no error. See
    -- docs/schema-guide.md "Ordering Events (There Is No Commit-Order Column)".
    Id text primary key,
    ParticipantId text not null,
    Content text not null,
    -- NOTE: client-asserted, not server-verified — the engine has no server-assigned
    -- alternative (non-deterministic functions like current-time are rejected by the
    -- determinism validator at schema definition time). See docs/schema-guide.md
    -- "Ordering Events (There Is No Commit-Order Column)".
    Timestamp datetime not null,
    foreign key (ParticipantId) references Participant(Id)
);

